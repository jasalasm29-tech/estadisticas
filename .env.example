# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key (SOLO servidor, omite RLS — no exponer al cliente)
SUPABASE_SERVICE_ROLE_KEY=

# Football Data API (https://www.football-data.org/)
FOOTBALL_DATA_API_KEY=

# Flow.cl (pagos en CLP)
NEXT_PUBLIC_FLOW_API_KEY=
FLOW_SECRET_KEY=
FLOW_COMMERCE_CODE=

# Google AdSense
# Client ID con formato ca-pub-XXXXXXXXXXXXXXXX
NEXT_PUBLIC_GOOGLE_ADSENSE_ID=
# IDs de bloques de anuncio (data-ad-slot) creados en tu cuenta de AdSense
NEXT_PUBLIC_ADSENSE_SLOT_HOME=
NEXT_PUBLIC_ADSENSE_SLOT_FOOTER=
NEXT_PUBLIC_ADSENSE_SLOT_DASHBOARD=
NEXT_PUBLIC_ADSENSE_SLOT_DASHBOARD_FOOTER=
